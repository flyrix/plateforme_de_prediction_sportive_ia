# ──────────────────────────────────────────────
# IA-BetPredict — Variables d'environnement
# Copie ce fichier en .env et remplis les valeurs
# NE JAMAIS commiter le fichier .env
# ──────────────────────────────────────────────

# Connexion PostgreSQL Neon (obligatoire)
DATABASE_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require

# Clé secrète pour protéger le endpoint /run-daily-job
# Génère une clé aléatoire : python -c "import secrets; print(secrets.token_hex(32))"
CRON_SECRET=<random-hex-secret>

# À n'utiliser qu'en développement si tu veux appeler les endpoints admin
# sans CRON_SECRET. En production, laisse false.
ALLOW_UNAUTHENTICATED_ADMIN=false

# Origines CORS autorisées (séparées par des virgules)
# En développement, laisser vide ou mettre * 
# En production : https://ia-betpredict.vercel.app
ALLOWED_ORIGINS=*

# ScrapingAnt pour Sofascore.
# Par défaut, browser=false suffit pour les endpoints JSON et coûte moins cher.
# Si Sofascore bloque les IP datacenter, teste SCRAPINGANT_PROXY_TYPE=residential.
SCRAPINGANT_KEY=
SCRAPINGANT_BROWSER=false
SCRAPINGANT_PROXY_TYPE=datacenter
SCRAPINGANT_PROXY_COUNTRY=
SCRAPINGANT_TIMEOUT=25
